            "text": "{\"id\":31,\"title\":\"PUBG Mobile\",\"cover\":\"https://cdn.payga.me/cover/2021/11/30/pubg-mobile-screen_1.jpg\",\"icon\":\"https://cdn.payga.me/icon/2023/10/19/icon-pubg-mobile.svg\",\"icon_large\":\"https://cdn.payga.me/icon_large/2021/11/30/pubgm-icon.png\",\"display\":null,\"description\":\"PUBG как на ПК, только на мобилке. Множество различных скинов для героев и оружия, которые можно получить с боксов или приобрести за донат. Донат, который позволит вашему аккаунту взлететь в стоимости до небес. Коллабы с другими играми, постоянные обновления и запредельный онлайн. Игра имеет огромную популярность, как на рынке СНГ, так и во всем мире.\",\"slug\":\"pubg-mobile\",\"game_group\":{\"id\":7,\"title\":\"PUBG\",\"games\":[{\"id\":31,\"title\":\"PUBG Mobile\",\"slug\":\"pubg-mobile\",\"icon\":\"https://cdn.payga.me/icon/2023/10/19/icon-pubg-mobile.svg\",\"default_category\":{\"slug\":\"games\",\"name\":\"Игры\"}},{\"id\":32,\"title\":\"PUBG\",\"slug\":\"pubg\",\"icon\":\"https://cdn.payga.me/icon/2023/10/19/icon-pubg.svg\",\"default_category\":{\"slug\":\"games\",\"name\":\"Игры\"}},{\"id\":131,\"title\":\"New State Mobile\",\"slug\":\"new-state-mobile\",\"icon\":\"https://cdn.payga.me/icon/2025/01/10/icon-new-state.svg\",\"default_category\":{\"slug\":\"games\",\"name\":\"Игры\"}}]},\"is_popular\":true,\"offer_data\":[{\"id\":2180,\"display\":\"table\",\"seo_data\":null,\"offer_type\":{\"id\":245,\"slug\":\"brejnroty\",\"name\":\"Брейнроты\",\"position\":0,\"variant\":\"default\",\"props\":[{\"id\":343,\"name\":\"Тип\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":false}],\"icon\":null},\"allow_unlimited\":true,\"allow_video_link\":false,\"allow_auto_delivery\":true,\"trusted_only\":false,\"allow_options\":false,\"media_disabled\":false},{\"id\":1857,\"display\":\"row\",\"seo_data\":2091,\"offer_type\":{\"id\":225,\"slug\":\"kar