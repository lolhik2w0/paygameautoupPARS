            "text": "[{\"id\":9,\"title\":\"У нас обновление!\",\"image\":\"https://cdn.payga.me/stories/groups/2026/05/22/story-79a44b16-f812-4256-96f1-cc96caed782d.jpeg\",\"image_url\":null,\"is_active\":true,\"type\":\"seller\",\"created_at\":\"2026-05-22T22:10:05.426098Z\",\"expires_at\":null,\"slides_count\":1,\"is_viewed\":true},{\"id\":8,\"title\":\"Растём в RMT\",\"image\":\"https://cdn.payga.me/stories/groups/2026/05/22/story-bf97434e-7159-489b-a703-478ad2adaf21.jpeg\",\"image_url\":null,\"is_active\":true,\"type\":\"seller\",\"created_at\":\"2026-05-22T21:21:56.430503Z\",\"expires_at\":null,\"slides_count\":1,\"is_viewed\":true},{\"id\":7,\"title\":\"Когда нет продаж\",\"image\":\"https://cdn.payga.me/stories/groups/2026/05/22/story-d89e9b29-0988-41cc-a56a-9709bc76a26b.jpeg\",\"image_url\":null,\"is_active\":true,\"type\":\"seller\",\"created_at\":\"2026-05-22T21:20:54.510047Z\",\"expires_at\":null,\"slides_count\":1,\"is_viewed\":true},{\"id\":6,\"title\":\"Повышаем средний чек\",\"image\":\"https://cdn.payga.me/stories/groups/2026/05/22/story-2dc55352-c44a-43a7-882b-a73ee8ac5b23.jpeg\",\"image_url\":null,\"is_active\":true,\"type\":\"seller\",\"created_at\":\"2026-05-22T21:19:58.473886Z\",\"expires_at\":null,\"slides_count\":1,\"is_viewed\":true},{\"id\":5,\"title\":\"Проблемные клиенты\",\"image\":\"https://cdn.payga.me/stories/groups/2026/05/22/story-237704de-df59-45ac-b149-ec4e942fe495.jpeg\",\"image_url\":null,\"is_active\":true,\"type\":\"seller\",\"created_at\":\"2026-05-22T21:19:16.436484Z\",\"expires_at\":null,\"slides_count\":1,\"is_viewed\":true},{\"id\":4,\"title\":\"Как найти первого клиента\",\"image\":\"https://cdn.payga.me/stories/groups/2026/05/22/story-79f19be5-b39b-4f50-8352-69c977f4af2c.jpeg\",\"image_url\":null,\"is_active\":true,\"type\":\"seller\",\"created_at\":\"2026-05-22T21:18:20.484255Z\",\"expires_at\":null,\"slides_count\":1,\"is_viewed\":true},{\"id\":3,\"title\":\"Пишем в поддержку правильно\",\"image\":\"https://cdn.payga.