            "text": "[{\"id\":364,\"title\":\"Voicemod\",\"cover\":\"https://cdn.payga.me/cover/2026/08/04/Voicemod.png\",\"icon\":\"https://cdn.payga.me/icon/2026/09/03/icon-voicemod.svg\",\"icon_large\":\"https://cdn.payga.me/icon_large/2026/08/04/Voicemod.webp\",\"display\":null,\"description\":\"Voicemod — программа, которая превращает обычный микрофон в голос робота, монстра, героя игры или человека, явно скрывающегося от тиммейтов. Она меняет голос в реальном времени и позволяет запускать звуки через встроенный саундборд во время звонков и стримов. На PayGame можно оплатить Voicemod и открыть подходящий формат доступа к дополнительным эффектам.\",\"slug\":\"voicemod\",\"is_popular\":false,\"offer_data\":[{\"id\":2074,\"display\":\"row\",\"seo_data\":2322,\"offer_type\":{\"id\":167,\"slug\":\"subscriptions\",\"name\":\"Подписка\",\"position\":0,\"variant\":\"default\",\"props\":[{\"id\":324,\"name\":\"Вход в аккаунт\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":true},{\"id\":135,\"name\":\"Срок\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":true,\"show_offer_title_icon\":false,\"is_required\":true}],\"icon\":\"https://cdn.payga.me/offer_type_icon/2026/02/27/subscriptions.png\"},\"allow_unlimited\":true,\"allow_video_link\":false,\"allow_auto_delivery\":true,\"trusted_only\":true,\"allow_options\":true,\"media_disabled\":false},{\"id\":2073,\"display\":\"row\",\"seo_data\":2405,\"offer_type\":{\"id\":2,\"slug\":\"account\",\"name\":\"Аккаунты\",\"position\":3,\"variant\":\"account\",\"props\":[{\"id\":324,\"name\":\"Вход в аккаунт\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":true},{\"id\":320,\"name\":\"Чистый аккаунт\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":true},{\"id\":138,\"name\":\"Гарантия продавца\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":true}],\"icon\":\"https://cdn.payga.me/offer_type_icon/2026/02/27/account.png\"},\"allow_unlimited\":true,\"allow_video_link\":false,\"allow_auto_delivery\":true,\"trusted_only\":true,\"allow_options\":true,\"media_disabled\":false}],\"is_active\":true,\"disclaimer\":\"\",\"show\":true,\"default_category\":{\"slug\":\"software\",\"name\":\"Программы\"},\"game_group\":null,\"is_favourite\":false},{\"id\":348,\"title\":\"Dropbox\",\"cover\":\"https://cdn.payga.me/cover/2026/07/24/dropbox.png\",\"icon\":\"https://cdn.payga.me/icon/2026/08/08/icon-dropbox.svg\",\"icon_large\":\"https://cdn.payga.me/icon_large/2026/07/31/classic-dropbox-logo-editable-and-for-tech-branding-and-creative-d_kvn5qaS.png\",\"display\":null,\"description\":\"Dropbox — облачное хранилище для синхронизации, передачи и совместной работы с файлами. Сервис помогает держать документы, фотографии, видео и рабочие папки доступными на разных устройствах, а также удобно делиться крупными материалами. На PayGame можно купить подписку Dropbox, чтобы увеличить объем хранилища и получить дополнительные инструменты для работы с файлами.\",\"slug\":\"dropbox\",\"is_popular\":false,\"offer_data\":[{\"id\":2034,\"display\":\"row\",\"seo_data\":null,\"offer_type\":{\"id\":167,\"slug\":\"subscriptions\",\"name\":\"Подписка\",\"position\":0,\"variant\":\"default\",\"props\":[{\"id\":306,\"name\":\"Тип подписки\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":false},{\"id\":324,\"name\":\"Вход в аккаунт\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_