          "cookies": [],
          "content": {
            "size": 11032,
            "mimeType": "application/json",
            "text": "{\"current_page\":1,\"next\":2,\"last_page\":9,\"previous\":null,\"current_page_url\":\"http://api.paygame.ru/api/v1/ideas/?page=1&status=implemented\",\"next_url\":\"http://api.paygame.ru/api/v1/ideas/?page=2&status=implemented\",\"last_page_url\":\"http://api.paygame.ru/api/v1/ideas/?page=9&status=implemented\",\"previous_url\":null,\"total\":86,\"start_index\":1,\"end_index\":10,\"results\":[{\"id\":1061,\"title\":\"Фильтрация по статусу продавца: не показывать объявления от заблокированных\",\"description\":\"Ввести функцию сортировки и фильтрации продавцов так, чтобы после блокировки конкретного продавца его объявления не показывались в ленте\",\"author\":{\"id\":533225,\"username\":\"WT_Kotost_Shop\",\"avatar\":\"https://cdn.payga.me/avatar/2026/08/04/klytoiplo_avatar_aDuGSuA.jpg\",\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":false}},\"plan\":{\"id\":2,\"title\":\"Новичок\",\"slug\":\"free\",\"image\":null},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-08-10T15:29:50.138440Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false},{\"id\":1058,\"title\":\"Другие категории лотов\",\"description\":\"что бы были не только игры го и звезды в телеграмме и монеты в тик токе и т.д\",\"author\":{\"id\":516014,\"username\":\"Вчера\",\"avatar\":\"https://cdn.payga.me/avatar/2026/07/20/%D0%92%D1%87%D0%B5%D1%80%D0%B0_avatar.jfif\",\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":true}},\"plan\":{\"id\":2,\"title\":\"Новичок\",\"slug\":\"free\",\"image\":null},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-08-04T05:57:12.284550Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false},{\"id\":1054,\"title\":\"Увеличение каталога\",\"description\":\"Здравствуйте,я уверен каждый ищет звезды в Telegram, либо же UserName ну либо же NFT подарки,так вот хотел бы предложить вам разработчики данной площадки,чтобы вы расширили каталог товаров,потому что я уверен после данной процедуры прийдут многие покупатели на данную площадку,так как многие ищут заезды и другие товары для Telegram\",\"author\":{\"id\":526283,\"username\":\"ACRONIX\",\"avatar\":\"https://cdn.payga.me/avatar/2026/08/02/ACRONIX_avatar.jpeg\",\"banned\":{\"freeze\":{\"status\":true},\"ban\":{\"status\":false}},\"plan\":{\"id\":2,\"title\":\"Новичок\",\"slug\":\"free\",\"image\":null},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-08-02T09:34:53.956896Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false},{\"id\":1021,\"title\":\"я бы хотел чтобы сюда добавили приложение телеграмм для покупки и продажи вещей с него\",\"description\":\"/\",\"author\":{\"id\":484551,\"username\":\"kentafarik\",\"avatar\":null,\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":false}},\"plan\":{\"id\":2,\"title\":\"Новичок\",\"slug\":\"free\",\"image\":null},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-07-04T19:07:20.082925Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false},{\"id\":1008,\"title\":\"Создать отдельный окно для не игр\",\"description\":\"Можно создать отдельное окно для различных приложений по типу тик тока, телеграма и тому подобных приложений ведь люди 12-17 лет очень нужны различные услуги в этих приложений\",\"author\":{\"id\":400861,\"username\":\"madul_shop\",\"avatar\":\"https://cdn.payga.me/avatar/2026/06/17/Madul_avatar.jpg\",\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":true}},\"plan\":{\"id\":2,\"title\":\"Новичок\",\"slug\":\"free\",\"image\":null},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-06-18T17:38:58.919391Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false},{\"id\":995,\"title\":\"Наказание за не соблюдение правил пользования площадкой .\",\"description\":\"Так как угрозы ук рф на мошенников промышляющие мелким мошенничеством не влияют ввиду того ,что многие из них знают , что уголовное дело можно открыть только если украсть более 2т. р. а так же мало кто за эти деньги будет обращаться в правоохранительные органы ,.Предлогаю вам ввести бан по железу или по ip адресу и передавать такую информацию на контактные адреса других площадок , для того , что бы и на других площадках такие люди не могли торговать , так же сама угроза такого бана будет служить стимулом для продавцов относиться более серьезнее к своему товару .\\nПункты и задачи блокировки по ip :\\n1.Не возможность выводить средства \\n2.Блокировка каждого нового аккаунта созданного после бана \\n3.Замарозка активов выставленные на продажу в случае с автопродажей , то есть в ручную менять данные аккаунта , для дальнейшей реализации сайтом таких  аккаунтов себе в козну .\\nПродажа самим сайтом аккаунтов или товаров с пометкой или галочкой 100% гарантия от самого сайта\",\"author\":{\"id\":338156,\"username\":\"dfe\",\"avatar\":\"https://cdn.payga.me/avatar/2026/05/30/dfe_avatar.jpeg\",\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":false}},\"plan\":{\"id\":2,\"title\":\"Новичок\",\"slug\":\"free\",\"image\":null},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-06-07T13:56:43.252861Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false},{\"id\":982,\"title\":\"Добавление ИИ в каталог сайта\",\"description\":\"Было бы круто, если бы добавили возможность продать ии подписки, с помощью их можно делать изображения, видео и ТД тп. Щас все покупают нейронки для ТТ и прочих вещей. Поэтому я бы хотел, чтобы появились нейронки Чат гпт, Gemini pro, Claude AI, Grok,\",\"author\":{\"id\":322278,\"username\":\"Shop.ruuu\",\"avatar\":\"https://cdn.payga.me/avatar/2026/03/05/Shop.ruuu_avatar.jpg\",\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":false}},\"plan\":{\"id\":1,\"title\":\"Мастер\",\"slug\":\"premium\",\"image\":\"https://cdn.payga.me/plan/2021/01/18/crown.svg\"},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-06-01T08:14:43.782613Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false},{\"id\":977,\"title\":\"Поиск продавцов\",\"description\":\"В некоторых площадках есть поисковик продавцов , тут впринципе можно тоже реализовать , чтоб челам было легче найди продавца и купить у него товар\",\"author\":{\"id\":90126,\"username\":\"Genshin_and_HSR\",\"avatar\":\"https://cdn.payga.me/avatar/2024/12/15/Genshin_and_HSR_avatar.png\",\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":false}},\"plan\":{\"id\":1,\"title\":\"Мастер\",\"slug\":\"premium\",\"image\":\"https://cdn.payga.me/plan/2021/01/18/crown.svg\"},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-05-31T20:59:26.994073Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":1,\"is_voted\":false},{\"id\":941,\"title\":\"дополнение описания к лоту  (пример: wot blitz)\",\"description\":\"сделать, чтобы в описании к лоту в пункте бои можно было ставить цифру 0 (или без боёв). сейчас если поставить ноль и нажать сохранить то оно не сохраняется. + покупателям будет удобно подбирать аккаунты с 0 боями\",\"author\":{\"id\":240941,\"username\":\"Halaster\",\"avatar\":\"https://cdn.payga.me/avatar/2026/05/02/Halaster_avatar_4qyuEwV.png\",\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":false}},\"plan\":{\"id\":2,\"title\":\"Новичок\",\"slug\":\"free\",\"image\":null},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-04-27T19:42:51.728957Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false},{\"id\":931,\"title\":\"Отображение/добавление - изображений в профиле на карточку товара\",\"description\":\"1 - Чем это удобно: Пример - я продаю скины в большом количестве - покупатель видя одно предложение, переходя в профиль ознакомится еще с десятком карточек о продаже предметов, но неудобство в том что придется кликать на каждую карточку чтоб просмотреть как выглядит скин - это крайне затягивает поиск!\\r\\n2 - Лот с картинкой выглядит намного привлекательней, если есть такая возможность при выставлении лота поместить изображение, почему бы его и не отображать на карточке в профиле, не переходя на лот ?\\r\\n3 Реализация - можно поместить следующим образом:\\r\\n*Изображение* - Раздел - Наименование - Цена \\r\\n-------------------------------------------------------------\\r\\nБуквально небольшой размер картинки но видимый\",\"author\":{\"id\":447893,\"username\":\"SellerFind\",\"avatar\":\"https://cdn.payga.me/avatar/2026/03/01/SellerFind_avatar.jpg\",\"banned\":{\"freeze\":{\"status\":false},\"ban\":{\"status\":false}},\"plan\":{\"id\":2,\"title\":\"Новичок\",\"slug\":\"free\",\"image\":null},\"is_support\":false,\"is_active\":true},\"created_date\":\"2026-04-19T03:14:32.106903Z\",\"status\":\"implemented\",\"tags\":[],\"rating\":0,\"comments\":0,\"is_voted\":false}]}"
          },
