            "text": "[{\"id\":359,\"title\":\"Razer Gold\",\"cover\":\"https://cdn.payga.me/cover/2026/07/31/razer.jpg\",\"icon\":\"https://cdn.payga.me/icon/2026/08/08/icon-razer.svg\",\"icon_large\":\"https://cdn.payga.me/icon_large/2026/08/04/razer-gold.png\",\"display\":\"row\",\"description\":\"Razer Gold — цифровой кошелек для игр и внутриигровых покупок, который поддерживается множеством проектов и платформ. С его помощью можно оплачивать контент, валюту, дополнения и другие товары без отдельной карты для каждой игры. На PayGame можно пополнить Razer Gold и вернуться к главному вопросу вечера: купить полезный предмет или снова потратить все на красивый скин.\",\"slug\":\"razer-gold\",\"is_popular\":false,\"offer_data\":[{\"id\":2062,\"display\":\"row\",\"seo_data\":null,\"offer_type\":{\"id\":106,\"slug\":\"giftcard\",\"name\":\"Подарочные карты\",\"position\":2,\"variant\":\"default\",\"props\":[{\"id\":328,\"name\":\"Валюта\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":true},{\"id\":117,\"name\":\"Количество\",\"type\":\"number\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":true}],\"icon\":\"https://cdn.payga.me/offer_type_icon/2026/02/27/giftcard.png\"},\"allow_unlimited\":true,\"allow_video_link\":false,\"allow_auto_delivery\":true,\"trusted_only\":true,\"allow_options\":true,\"media_disabled\":false}],\"is_active\":true,\"disclaimer\":\"\",\"show\":true,\"default_category\":{\"slug\":\"services\",\"name\":\"Сервисы и соцсети\"},\"game_group\":null,\"is_favourite\":false},{\"id\":361,\"title\":\"Telegram\",\"cover\":\"https://cdn.payga.me/cover/2026/07/31/telegram.jpg\",\"icon\":\"https://cdn.payga.me/icon/2026/08/08/icon-telegram.svg\",\"icon_large\":\"https://cdn.payga.me/icon_large/2026/08/04/Telegram.webp\",\"display\":null,\"descript