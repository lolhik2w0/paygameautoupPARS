            "text": "[{\"id\":354,\"title\":\"Copilot\",\"cover\":\"https://cdn.payga.me/cover/2026/07/31/copilot.jpg\",\"icon\":\"https://cdn.payga.me/icon/2026/08/08/icon-copilot_1.svg\",\"icon_large\":\"https://cdn.payga.me/icon_large/2026/07/31/logo_copilot.png\",\"display\":null,\"description\":\"Microsoft Copilot — ИИ-помощник для ситуаций, когда нужно придумать текст, разложить задачу по шагам, найти идею или разобраться в незнакомой теме. С ним можно общаться обычными вопросами без длинных технических команд. На PayGame можно оплатить Copilot и получить подходящий формат доступа — это полезно, когда мыслей много, а чистый лист уже смотрит с осуждением.\",\"slug\":\"copilot\",\"is_popular\":false,\"offer_data\":[{\"id\":2049,\"display\":\"row\",\"seo_data\":2428,\"offer_type\":{\"id\":167,\"slug\":\"subscriptions\",\"name\":\"Подписка\",\"position\":0,\"variant\":\"default\",\"props\":[{\"id\":306,\"name\":\"Тип подписки\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":false},{\"id\":324,\"name\":\"Вход в аккаунт\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":false,\"show_offer_title_icon\":false,\"is_required\":true},{\"id\":135,\"name\":\"Срок\",\"type\":\"list\",\"show_filter\":true,\"show_columns\":true,\"show_offer_title\":false,\"show_before_title\":true,\"show_offer_title_icon\":false,\"is_required\":true}],\"icon\":\"https://cdn.payga.me/offer_type_icon/2026/02/27/subscriptions.png\"},\"allow_unlimited\":true,\"allow_video_link\":false,\"allow_auto_delivery\":true,\"trusted_only\":true,\"allow_options\":true,\"media_disabled\":false},{\"id\":2048,\"display\":\"row\",\"seo_data\":null,\"offer_type\":{\"id\":2,\"slug\":\"account\",\"name\":\"Аккаунты\",\"position\":3,\"variant\":\"account\",\"props\":[{\"id\":324,\"name\":\"Вход в аккаунт\",\"type\":\"list\",\"show_filter\":